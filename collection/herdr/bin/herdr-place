#!/usr/bin/env python3
"""Reorder and positionally create herdr tabs and workspaces.

herdr exposes tab.move and workspace.move over the socket API, but neither is
a bindable action nor a CLI subcommand, so keybindings have to reach them
through this script.

usage: herdr-place <tab|workspace> <move-prev|move-next|new-prev|new-next>

  move-prev   shift the focused item one position earlier
  move-next   shift it one position later
  new-prev    create an item and place it immediately before the focused one
  new-next    create an item and place it immediately after the focused one

The socket path comes from HERDR_SOCKET_PATH when herdr sets it for a custom
command, and falls back to the default location otherwise.
"""

import json
import os
import socket
import sys

DEFAULT_SOCKET = os.path.expanduser("~/.config/herdr/herdr.sock")


class HerdrError(RuntimeError):
    pass


def call(method, params=None):
    """Send one request over the socket and return its result payload."""
    path = os.environ.get("HERDR_SOCKET_PATH") or DEFAULT_SOCKET
    if not os.path.exists(path):
        raise HerdrError(f"no herdr socket at {path}")

    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    conn.settimeout(5)
    try:
        conn.connect(path)
        conn.sendall((json.dumps({
            "id": "herdr-place",
            "method": method,
            "params": params or {},
        }) + "\n").encode())

        buf = b""
        while b"\n" not in buf:
            chunk = conn.recv(65536)
            if not chunk:
                raise HerdrError(f"{method}: connection closed early")
            buf += chunk
    finally:
        conn.close()

    reply = json.loads(buf.split(b"\n", 1)[0])
    if "error" in reply:
        raise HerdrError(f"{method}: {reply['error'].get('message', reply['error'])}")
    return reply.get("result", {})


def focused_index(items):
    for i, item in enumerate(items):
        if item.get("focused"):
            return i
    raise HerdrError("nothing is focused")


def workspaces():
    return call("workspace.list")["workspaces"]


def tabs(workspace_id):
    return call("tab.list", {"workspace_id": workspace_id})["tabs"]


def focused_workspace_id():
    items = workspaces()
    return items[focused_index(items)]["workspace_id"]


def place(kind, action):
    """Look up the current order, then move or create-and-move within it."""
    if kind == "workspace":
        listing, id_key = workspaces, "workspace_id"
        create, move = "workspace.create", "workspace.move"
        create_params = {}
    else:
        wsid = focused_workspace_id()
        listing = lambda: tabs(wsid)  # noqa: E731 - one-line binding reads clearer here
        id_key = "tab_id"
        create, move = "tab.create", "tab.move"
        create_params = {"workspace_id": wsid}

    items = listing()
    index = focused_index(items)

    # insert_index counts positions in the list as it stands before the move,
    # including the moved item itself. Shifting one place later therefore needs
    # index + 2, not index + 1.
    if action in ("move-prev", "move-next"):
        if action == "move-prev":
            if index == 0:
                return
            target = index - 1
        else:
            if index == len(items) - 1:
                return
            target = index + 2
        call(move, {id_key: items[index][id_key], "insert_index": target})
        return

    # new-prev / new-next: create focused, then place it relative to the slot
    # the previously focused item occupied.
    call(create, {**create_params, "focus": True})
    items = listing()
    new_index = focused_index(items)
    target = index if action == "new-prev" else index + 1
    if target != new_index:
        call(move, {id_key: items[new_index][id_key], "insert_index": target})


def main():
    kinds = ("tab", "workspace")
    actions = ("move-prev", "move-next", "new-prev", "new-next")

    if len(sys.argv) != 3 or sys.argv[1] not in kinds or sys.argv[2] not in actions:
        print(f"usage: {os.path.basename(sys.argv[0])} "
              f"<{'|'.join(kinds)}> <{'|'.join(actions)}>", file=sys.stderr)
        return 2

    try:
        place(sys.argv[1], sys.argv[2])
    except (HerdrError, OSError, ValueError, KeyError) as err:
        print(f"herdr-place: {err}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
